{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "palette": {
    "accent": "#8098ff",
    "text": "#dcdbe1",
    "sub": "#989898",
    "dim": "#6e6c75",
    "surface": "#1e1e1e",
    "success": "#4cc38a",
    "warning": "#f0a53a",
    "danger": "#f2766b",
    "violet": "#a594ff",
    "label": "#131316",
    "line": "#2e2e2e",
    "accent-bg": "#2c3148",
    "success-bg": "#203a2e",
    "warning-bg": "#44341c",
    "violet-bg": "#343048",
    "danger-bg": "#452a27",
    "sub-bg": "#313131"
  },
  "transient_prompt": {
    "template": "<p:dim>{{ if eq .PWD \"~\" }}~{{ else }}{{ .Folder }}{{ end }}</> {{ if gt .Code 0 }}<p:danger>❯</>{{ else }}<p:accent>❯</>{{ end }} ",
    "background": "transparent"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:dim",
          "template": "╭─"
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:accent",
          "background": "p:accent-bg",
          "properties": {
            "style": "folder"
          },
          "template": " {{ .Path }} ",
          "leading_powerline_symbol": "\ue0b6",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "p:success",
          "background": "p:success-bg",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:warning{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:violet{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_stash_count": true,
            "branch_icon": "\ue0a0 "
          },
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:warning-bg{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:violet-bg{{ end }}"
          ]
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "foreground": "p:sub",
          "background": "p:sub-bg",
          "properties": {
            "threshold": 500,
            "style": "austin"
          },
          "template": " \ueba2 {{ .FormattedMs }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "status",
          "style": "powerline",
          "foreground": "p:danger",
          "background": "p:danger-bg",
          "template": " \uf00d {{ reason .Code }} ",
          "powerline_symbol": "\ue0b0"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:violet",
          "template": "{{ if .SSHSession }}\ueba9 {{ .UserName }}@{{ .HostName }}  {{ end }}"
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:dim",
          "properties": {
            "time_format": "15:04"
          },
          "template": "{{ .CurrentDate | date .Format }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:dim",
          "template": "╰─"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:accent",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:danger{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "❯ "
        }
      ]
    }
  ]
}
