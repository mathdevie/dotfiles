{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "palette": {
    "accent": "#8098ff",
    "sub": "#989898",
    "success": "#4cc38a",
    "warning": "#f0a53a",
    "danger": "#f2766b",
    "violet": "#a594ff"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:accent",
          "properties": {
            "style": "folder"
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:success",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:warning{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:violet{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "branch_icon": ""
          },
          "template": "{{ .HEAD }}{{ if .Working.Changed }}*{{ end }}{{ if .Staging.Changed }}+{{ end }}{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:sub",
          "properties": {
            "threshold": 500,
            "style": "austin"
          },
          "template": "{{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:accent",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:danger{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "{{ if gt .Code 0 }}{{ .Code }} {{ end }}❯ "
        }
      ]
    }
  ]
}
